# ===========================================
# Cubafoussam — Variables d'environnement
# ===========================================
# Copiez ce fichier vers .env.local et renseignez les valeurs.
# Ne commitez jamais .env.local (déjà dans .gitignore).

# --- MySQL (base cubafoussam) ---
# En production, utilisez un utilisateur dédié (pas root) avec les seuls droits
# SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX sur la base cubafoussam.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=cubafoussam_app
MYSQL_PASSWORD=votre_mot_de_passe_mysql
MYSQL_DATABASE=cubafoussam

# --- Premier compte admin (UNIQUEMENT pour npm run create-admin) ---
# À retirer du fichier une fois le compte créé. Relancer create-admin
# réinitialise le mot de passe de ce compte et le réactive.
ADMIN_EMAIL=admin@cubafoussam.cm
ADMIN_PASSWORD=

# --- Session admin (JWT cookie) — obligatoire pour /admin ---
# 32 caractères minimum, sinon l'application refuse de démarrer les sessions.
# Générez-la avec : openssl rand -base64 48
# La changer déconnecte tous les utilisateurs.
ADMIN_SESSION_SECRET=

# --- Formulaire de contact (envoi SMTP) ---
# Paramètres SMTP de la boîte mail du domaine cubafoussam.cm.
# Port 465 = SSL, port 587 = STARTTLS. Sans SMTP_HOST, les messages sont
# seulement enregistrés en base (visibles dans /admin/messages).
SMTP_HOST=mail.cubafoussam.cm
SMTP_PORT=465
SMTP_USER=contact@cubafoussam.cm
SMTP_PASSWORD=mot_de_passe_de_la_boite_mail
# Expéditeur affiché (par défaut SMTP_USER) et destinataire des messages
SMTP_FROM="Portail CUB <contact@cubafoussam.cm>"
CONTACT_EMAIL_TO=contact@cubafoussam.cm

# --- Suivi du courrier (API publique Flowmanager) ---
# Utilisées uniquement côté serveur par /api/suivi : ne JAMAIS les préfixer par NEXT_PUBLIC_.
# FLOWMANAGER_TRACKING_KEY = même valeur que PUBLIC_TRACKING_API_KEY côté Flowmanager.
# Côté Flowmanager : PUBLIC_TRACKING_URL=https://cubafoussam.cm/suivi et l'IP de sortie
# de ce serveur dans PUBLIC_TRACKING_ALLOWED_IPS. Sans ces variables, le suivi affiche
# « Service momentanément indisponible ».
FLOWMANAGER_URL=https://flowmanager.mairie.cm
FLOWMANAGER_TRACKING_KEY=

# --- Google Analytics 4 (chargé uniquement après acceptation des cookies, jamais dans /admin) ---
# Identifiant de mesure « G-XXXXXXXXXX ». Intégré au code au moment du build :
# sur Coolify, la déclarer comme « Build Variable » puis redéployer.
NEXT_PUBLIC_GA_ID=
